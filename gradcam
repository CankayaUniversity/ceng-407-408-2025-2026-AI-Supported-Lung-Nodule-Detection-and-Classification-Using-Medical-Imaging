def find_file_by_path(root_folder_id, path_list):
    """Klasör hiyerarşisi içinde dosya bulmak için path kullan"""
    current_parent_id = root_folder_id
    
    for item_name in path_list[:-1]:  # Son öğe dosya adı
        # Klasör ara
        query = f"'{current_parent_id}' in parents and title = '{item_name}' and mimeType = 'application/vnd.google-apps.folder' and trashed=false"
        file_list = drive.ListFile({'q': query}).GetList()
        
        if not file_list:
            return None
            
        target_item = file_list[0]
        current_parent_id = target_item['id']
    
    # Son öğe dosya adı
    file_name = path_list[-1]
    query = f"'{current_parent_id}' in parents and title = '{file_name}' and trashed=false"
    file_list = drive.ListFile({'q': query}).GetList()
    
    if file_list:
        return file_list[0]['id']
    return None

# model kısmı

def build_segresnet_model():
    model = SegResNet(
        spatial_dims=2,
        init_filters=8,
        in_channels=5,
        out_channels=1,
        blocks_down=(1, 2, 2, 4),
        blocks_up=(1, 1, 1),
        use_conv_final=True,
    )

    ckpt = torch.load("segresnet_25d_best.pt", map_location="cpu")
    if isinstance(ckpt, dict):
        if "model_state_dict" in ckpt:
            state_dict = ckpt["model_state_dict"]
        elif "state_dict" in ckpt:
            state_dict = ckpt["state_dict"]
        else:
            state_dict = ckpt
    else:
        state_dict = ckpt

    model.load_state_dict(state_dict)
    model.eval()
    return model


def get_target_layers(model):
    if hasattr(model, "down_layers"):
        return [model.down_layers[-1]]
    if hasattr(model, "layer4"):
        return [model.layer4[-1]]
    if hasattr(model, "features"):
        return [model.features[-1]]
    raise ValueError(f"Cannot find target layer for Grad-CAM. Model type: {type(model)}")


