    '''
    # Grad-CAM Hesapla
    grayscale_cam = cam(input_tensor=input_tensor, targets=targets)
    
    # grayscale_cam zaten (batch, H, W) döner. İlk elemanı alalım.
    cam_map = grayscale_cam[0] 

    # Reshape hatasını önlemek için güvenli kontrol
    if cam_map.ndim != 2:
        side = int(np.sqrt(cam_map.size))
        # Eğer tam kare değilse (örn: 224), orijinal giriş boyutuna (224, 224) zorla
        if side * side != cam_map.size:
            cam_map = cv2.resize(cam_map.reshape(1, -1), (224, 224))
        else:
            cam_map = cam_map.reshape((side, side))

    # Boyutu giriş görüntüsüyle eşitle (SegResNet çıktı boyutu farklı olabilir)
    cam_map = cv2.resize(cam_map, (224, 224))
    # 1. Grad-CAM haritasını 0-1 arasına normalize et
    cam_map_norm = (cam_map - cam_map.min()) / (cam_map.max() - cam_map.min() + 1e-8)
    cam_map_norm = 1.0 - cam_map_norm

    # 2. Özel Dereceli Colormap Oluşturma
    n_colors = 256
    base_cmap = plt.cm.jet
    color_array = base_cmap(np.linspace(0, 1, n_colors))

    # 3. Alpha (Şeffaflık) Kanalını Yoğunluğa Göre Ayarla
    threshold = 0.3  # Bu değerin altı tamamen şeffaf kalacak
    alphas = np.zeros(n_colors)

    # Threshold üzerindeki değerler için lineer artan şeffaflık (0.0'dan 0.8'e kadar)
    # Böylece en yoğun (kırmızı) yerler daha opak, kenarlar daha hayaletimsi olur
    mask_indices = np.linspace(0, 1, n_colors) > threshold
    alphas[mask_indices] = np.linspace(0.1, 0.8, np.sum(mask_indices))

    color_array[:, -1] = alphas  # Alpha kanalını renk dizisine ekle
    grad_cmap = mcolors.ListedColormap(color_array)

    with torch.no_grad():
        output = model(input_tensor)
        probabilities = torch.sigmoid(output)
        if probabilities.numel() == 1:
