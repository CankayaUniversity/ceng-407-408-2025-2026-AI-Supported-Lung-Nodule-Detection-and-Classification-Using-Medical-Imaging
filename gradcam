    class MultiSliceSegmentationTarget:
        def __init__(self, category):
            self.category = category

        def __call__(self, model_output):
            # model_output: [Batch, Channel, H, W]
            # Önce ilgili kanalı seçiyoruz
            if len(model_output.shape) == 4:
                target = model_output[0, self.category, :, :]
            else:
                target = model_output[self.category, :, :]
            
            # Sadece pozitif aktivasyonları (ReLU) al ve toplam skoru döndür
            # Bu skor scalar (tek bir sayı) olmalı ki Grad-CAM geriye doğru akabilsin
            return torch.sum(torch.relu(target))
        # 1. Target Layers: SegResNet'in son convolution katmanına odaklanalım
    target_layers = [model.conv_final] # En doğru anatomik doluluk buradan gelir

