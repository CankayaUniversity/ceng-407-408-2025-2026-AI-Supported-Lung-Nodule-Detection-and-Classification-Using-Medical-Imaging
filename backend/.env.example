# SQL Server Configuration
# Each developer must set their own local SQL Server instance name
# Examples: .\SQLEXPRESS, localhost\SQLEXPRESS, BMD\SQLEXPRESS01, PC-NAME\SQLEXPRESS

DB_SERVER=localhost\SQLEXPRESS
DB_DATABASE=lung_nodule

# OR: Use full connection strings (optional, overrides DB_SERVER)
# MASTER_CONNECTION_STRING=Server=localhost\SQLEXPRESS;Database=master;Trusted_Connection=True;
# APP_CONNECTION_STRING=Server=localhost\SQLEXPRESS;Database=lung_nodule;Trusted_Connection=True;

# Server port
PORT=3001

# Optional: point backend Python calls to a specific interpreter
# PYTHON_EXECUTABLE=C:\\path\\to\\python.exe
# BERTURK_MODEL_NAME=dbmdz/bert-base-turkish-cased
# BERTURK_MODEL_NAME=backend/models/bert-base-turkish-cased
# BERTURK_FINETUNED_MODEL_DIR=backend/models/berturk-risk-multilabel
