# Python cache
__pycache__/
**/__pycache__/
*.py[cod]

# Test/debug artifacts
backend/test_setup.py
IMPLEMENTATION_REPORT.md

lung25demo/

# ============================================================================
# SegResNet - LIDC-IDRI Dataset (DO NOT PUSH TO GITHUB)
# ============================================================================
# Raw DICOM files (133GB) - too large for GitHub
ai/SegResNet/data/lidc_raw/LIDC-IDRI-*/*.dcm
ai/SegResNet/data/lidc_raw/LIDC-IDRI-*/01-01/

# XML annotations (8.6MB, easily regenerated by organize_annotations.py)
# Users will run: python src/organize_annotations.py
ai/SegResNet/data/lidc_raw/Annotation/*.xml

# Processed volumes (large, regeneratable)
ai/SegResNet/data/lidc_processed/*.npy

# 2.5D dataset samples (large, regeneratable)
ai/SegResNet/data/lidc_25d/train/*.npz
ai/SegResNet/data/lidc_25d/val/*.npz
ai/SegResNet/data/lidc_25d/test/*.npz
ai/SegResNet/data/lidc_25d/split_metadata.json

# Training outputs (large, regeneratable)
ai/SegResNet/outputs/checkpoints/*.pth
ai/SegResNet/outputs/predictions/*.npy
ai/SegResNet/outputs/logs/

# Keep only code, configs, and utilities
!ai/SegResNet/configs/
!ai/SegResNet/src/
!ai/SegResNet/README.md

# Hardware detection config (machine-specific)
ai/SegResNet/hardware_config.json
